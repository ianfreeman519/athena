<comment>
problem = GEM Harris-Sheet Reconnection
configure = --prob=recon_GEM_harris -b --flux=hlld -hdf5 -h5double -mpi
reference = Authored by Ian Freeman

<job>
problem_id  = recon_GEM    # problem ID: basename of output filenames

<output1>
file_type   = hst       # History data dump
dt          = 5e-11     # time increment between outputs
data_format = %12.5e    # Optional data format string

<output2>
file_type = hdf5        # HDF5 data dump
variable  = prim        # variables to be output
dcycle        = 1       # time increment between outputs

<time>
cfl_number = 0.45        # The Courant, Friedrichs, & Lewy (CFL) Number
nlim       = -1         # cycle limit
tlim       = 3.0e-8     # time limit
integrator  = vl2       # time integration algorithm
xorder      = 2         # order of spatial reconstruction
ncycle_out  = 1         # interval for stdout summary info

<mesh>
nx1        = 2048        # Number of zones in X1-direction
x1min      = -6.4       # minimum value of X1
x1max      =  6.4       # maximum value of X1
ix1_bc     = outflow    # Inner-X1 boundary condition flag
ox1_bc     = outflow    # Outer-X1 boundary condition flag

nx2        = 4096        # Number of zones in X2-direction
x2min      = -12.8       # minimum value of X2
x2max      =  12.8       # maximum value of X2
ix2_bc     = outflow    # Inner-X2 boundary condition flag
ox2_bc     = outflow    # Outer-X2 boundary condition flag

nx3        = 1          # Number of zones in X3-direction
x3min      = -1.0       # minimum value of X3
x3max      = 1.0        # maximum value of X3
ix3_bc     = periodic   # Inner-X3 boundary condition flag
ox3_bc     = periodic   # Outer-X3 boundary condition flag

<meshblock>
nx1        = 512        # Number of zones in X1-direction
nx2        = 512        # Number of zones in X2-direction
nx3        = 1          # Number of zones in X3-direction

<hydro>
gamma      = 1.66666        # gamma = C_p/C_v

<problem>
B0 = 1
rho0 = 1
rho1 = 0.2
lambda = 0.5
phi0 = 0.1

eta_ohm = 0.1       # Corresponds to S_L ~ 8