<comment>
problem = Four Flux Tubes Reconnection
configure = --prob=recon_freem -b --flux=hlld -hdf5 -h5double -mpi -omp
reference = Authored by Ian Freeman

<job>
problem_id  = recon_freem    # problem ID: basename of output filenames

<output1>
file_type   = hst       # History data dump
dt          = 5e-3     # time increment between outputs
data_format = %12.5e    # Optional data format string

<output2>
file_type = hdf5        # HDF5 data dump
variable  = prim       # variables to be output
dcycle    = 1       # time increment between outputs

<output3>
file_type = hdf5
variable  = E
dcycle    = 1

<time>
cfl_number = 0.45        # The Courant, Friedrichs, & Lewy (CFL) Number
nlim       = -1         # cycle limit
tlim       = 3.0        # time limit
integrator  = vl2       # time integration algorithm
xorder      = 2         # order of spatial reconstruction
ncycle_out  = 1         # interval for stdout summary info

<mesh>
nx1        = 1600        # Number of zones in X1-direction
x1min      = -0.70710678118       # minimum value of X1 (-L/2)
x1max      =  0.70710678118       # maximum value of X1  (L/2)
ix1_bc     = periodic    # Inner-X1 boundary condition flag
ox1_bc     = periodic    # Outer-X1 boundary condition flag

nx2        = 1600        # Number of zones in X2-direction
x2min      = -0.70710678118       # minimum value of X2 (-L/2)
x2max      =  0.70710678118       # maximum value of X2  (L/2)
ix2_bc     = outflow    # Inner-X2 boundary condition flag
ox2_bc     = outflow    # Outer-X2 boundary condition flag

nx3        = 1          # Number of zones in X3-direction
x3min      = -1.0       # minimum value of X3
x3max      = 1.0        # maximum value of X3
ix3_bc     = periodic   # Inner-X3 boundary condition flag
ox3_bc     = periodic   # Outer-X3 boundary condition flag

refinement = static

<refinement1>
x1min = -0.70710678118
x1max =  0.70710678118
x2min = -0.1
x2max =  0.1
x3min =  0.0
x3max =  0.0
level =  3

<meshblock>
nx1        = 200        # Number of zones in X1-direction
nx2        = 200        # Number of zones in X2-direction
nx3        = 1          # Number of zones in X3-direction

<hydro>
gamma      = 1.001        # gamma = C_p/C_v
iso_sound_speed = 1.0

<problem>
P0         = 6
rho0       = 1
A0         = 0.01061032953933   # A0/30                # A0         = 0.31830988618      # L/sqrt(2)pi
L          = 1.41421356237      # sqrt(2)
powRho     = 0.0
powP       = 2.0
eta_ohm    = 8.255e-8
bz         = 0.0
vin0       = 1.0
powv       = 2.0